{
    "author": "Daan van den Bergh",
    "name": "@vandenberghinc/volt",
    "version": "1.2.13",
    "description": "",
    "type": "module",
    "types": "./backend/dist/esm/index.d.ts",
    "main": "./backend/dist/cjs/index.js",
    "module": "./backend/dist/esm/index.js",
    "exports": {
        ".": {
            "require": "./backend/dist/cjs/backend/src/index.js",
            "import": "./backend/dist/esm/backend/src/index.js"
        },
        "./frontend": {
            "import": "./frontend/dist/frontend/src/index.js"
        }
    },
    "files": [
        "frontend/assets/**",
        "frontend/css/**",
        "frontend/dist/**",
        "backend/dist/**",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "link": "vrepo --npm --link --dependencies ../vlib/ts/,../vhighlight/",
        "unlink": "vrepo --npm --unlink",
        "build": "npm run build:backend --silent && npm run build:backend:cjs --silent && npm run build:frontend --silent",
        "build:backend": "tsc -p backend/tsconfig.json",
        "build:backend:cjs": "vts --transform-esm --debug 1 --src backend/dist/esm/ --dest backend/dist/cjs/ --override --platform node --target es2023",
        "build:frontend": "tsc -p frontend/tsconfig.json",
        "start": "node start.js",
        "check-circular-dependencies": "npx madge --circular frontend/src/"
    },
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "volt": "./backend/dist/esm/cli.js",
        "volt-dev": "./backend/dist/esm-dev/cli.js"
    },
    "dependencies": {
        "@vandenberghinc/vhighlight": "^1.3.17",
        "@vandenberghinc/vlib": "^1.6.47",
        "blob-stream": "^0.1.3",
        "clean-css": "^5.3.3",
        "esbuild": "^0.25.12",
        "mongodb": "^6.21.0",
        "nodemailer": "^7.0.11",
        "pdfkit": "^0.14.0",
        "playwright": "^1.57.0",
        "sharp": "^0.33.5",
        "stripe": "^20.3.1"
    },
    "devDependencies": {
        "@types/node": "^22.19.1",
        "@types/nodemailer": "^7.0.4",
        "typescript": "^5.9.3"
    },
    "vrepo_links": {
        "@vandenberghinc/vlib": "../vlib/ts/",
        "@vandenberghinc/vhighlight": "../vhighlight/"
    }
}